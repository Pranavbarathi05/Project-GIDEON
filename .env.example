# .env.example — copy this file to .env and fill in real values.
# NEVER commit your actual .env file.

# ── Application ──────────────────────────────────────────────────────────────
# Environment label: development | staging | production
GIDEON_ENV=development

# Friendly name shown in status output
GIDEON_AGENT_NAME=GIDEON

# ── Logging ──────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR | CRITICAL
GIDEON_LOG_LEVEL=INFO

# Log output format: text | json
GIDEON_LOG_FORMAT=text

# Optional path for a log file; leave blank to log to stdout only.
GIDEON_LOG_FILE=
